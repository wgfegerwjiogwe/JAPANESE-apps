window.__jlptMap=new Map();window.__freqMap=new Map();
async function syncFull(){try{const [j,f,w]=await Promise.all([fetch(JLPT_URL).then(r=>r.json()),fetch(FREQ_URL).then(r=>r.json()),fetch(WORDS_URL).then(r=>{if(!r.ok)throw Error(r.status);return r.json()})]);window.__jlptMap=new Map((j.classifications||[]).filter(x=>x.kind==='vocab').map(x=>[String(x.jmdict_seq),{level:x.level,meaning:x.meaning_en||''}]));window.__freqMap=new Map((f.entries||[]).map(x=>[`${x.text||''}|${kataToHira(x.reading||'')}`,x]));const ext=syncNormalize(w);if(ext.length>5000){fullWords=ext;setData(`${ext.length.toLocaleString()} vocabulary words synced`,true);renderWordSettings();renderStats()}}catch(e){setData('806-word local bank active · full sync unavailable',false)}}
function setData(t,ok){$('#dataStatus').textContent=t}

/* Word pools: presets are length/familiarity filters, never fallbacks. */
function wordPool(){
 let a=fullWords.slice(),p=settings.wordPreset||'easy';
 if(p==='easy'){a=a.filter(w=>unitCount(w.hira)>=2&&unitCount(w.hira)<=4).sort((x,y)=>(x.freqRank??x._i??999999)-(y.freqRank??y._i??999999))}
 else if(p==='normal')a=a.filter(w=>unitCount(w.hira)>=3&&unitCount(w.hira)<=6);
 else if(p==='hard')a=a.filter(w=>unitCount(w.hira)>=5&&unitCount(w.hira)<=9);
 else if(p==='expert')a=a.filter(w=>unitCount(w.hira)>=7);
 else if(/^N[1-5]$/.test(p)){} else if(p==='all'){} else if(p==='custom')a=a.filter(w=>customWords.has(`${w.jp}|${w.hira}`));
 if(/^N[1-5]$/.test(p))a=a.filter(w=>w.level===p);
 if(p!=='easy')a.sort((x,y)=>(x.freqRank??999999)-(y.freqRank??999999));
 if(p==='custom')a.sort((x,y)=>(x.freqRank??999999)-(y.freqRank??999999));
 return a
}
function choose(pool,key){if(pool.length<=1)return pool[0]||null;const fresh=pool.filter(x=>!recent.includes(key(x))),src=fresh.length?fresh:pool;return src[Math.floor(Math.random()*src.length)]}
function addRecent(k){recent=[...recent.filter(x=>x!==k),k].slice(-RECENT_LIMIT)}

function kanaSelectionSignature(){return activeKana.join('|')}
function refillKanaUnitBag(group){
  group.bag=shuffle(group.units);
  if(group.bag.length>1 && kanaDistribution.lastGroup===group.key && group.bag[0]===kanaDistribution.lastUnit){
    const i=1+Math.floor(Math.random()*(group.bag.length-1));
    [group.bag[0],group.bag[i]]=[group.bag[i],group.bag[0]];
  }
}
function refillKanaGroupBag(){
  kanaDistribution.groupBag=shuffle(kanaDistribution.groups.map(g=>g.key));
  if(kanaDistribution.groupBag.length>1 && kanaDistribution.groupBag[0]===kanaDistribution.lastGroup){
    const i=1+Math.floor(Math.random()*(kanaDistribution.groupBag.length-1));
    [kanaDistribution.groupBag[0],kanaDistribution.groupBag[i]]=[kanaDistribution.groupBag[i],kanaDistribution.groupBag[0]];
  }
}
function resetKanaDistribution(){
  const selected=new Set(activeKana);
  kanaDistribution={
    signature:kanaSelectionSignature(),
    groups:KANA_GROUP_DEFS.map(d=>({key:d.key,units:d.units.filter(x=>selected.has(x)),bag:[]}))
      .filter(g=>g.units.length),
    groupBag:[],lastGroup:null,lastUnit:null
  };
  kanaDistribution.groups.forEach(refillKanaUnitBag);
  refillKanaGroupBag();
}
function ensureKanaDistribution(){
  if(kanaDistribution.signature!==kanaSelectionSignature())resetKanaDistribution();
  return kanaDistribution.groups.length>0;
}
function nextBalancedKana(){
  if(!ensureKanaDistribution())return null;
  if(!kanaDistribution.groupBag.length)refillKanaGroupBag();
  const group=kanaDistribution.groups.find(g=>g.key===kanaDistribution.groupBag.pop());
  if(!group)return nextBalancedKana();
  if(!group.bag.length)refillKanaUnitBag(group);
  let unit=group.bag.pop();
  if(unit===kanaDistribution.lastUnit && group.bag.length){
    const i=group.bag.length-1;
    [unit,group.bag[i]]=[group.bag[i],unit];
  }
  kanaDistribution.lastGroup=group.key;
  kanaDistribution.lastUnit=unit;
  return unit;
}

/* ---------- UI/state ---------- */
function settingsFor(){return mode==='kana'?{challenge:+settings.kanaChallenge,answer:+settings.kanaAnswer}:{challenge:+settings.wordChallenge,answer:+settings.wordAnswer}}
function draw(){let left=phase==='paused'?remaining:Math.max(0,deadline-performance.now()),total=settingsFor()[phase==='challenge'?'challenge':'answer']*1000;$('#timer').textContent=(left/1000).toFixed(1)+'s';$('#fill').style.width=Math.max(0,Math.min(100,left/total))*100+'%';renderStats();if(left<=0){transitionPhase();return}timerRaf=requestAnimationFrame(draw)}
function stopTimer(){if(timerRaf){cancelAnimationFrame(timerRaf);timerRaf=null}}
function startTimer(ms){stopTimer();remaining=ms;deadline=performance.now()+ms;currentPhaseStart=performance.now();draw()}
function pause(){if(!sessionActive||!current)return;if(phase==='challenge'||phase==='answer'){remaining=Math.max(0,deadline-performance.now());phase='paused';stopTimer();invalidateTts();$('#pauseBadge').classList.remove('hidden');$('#pauseBtn').textContent='Resume';renderStats()}}
function resume(){if(phase!=='paused')return;phase=current.pausePhase||'challenge';deadline=performance.now()+remaining;$('#pauseBadge').classList.add('hidden');$('#pauseBtn').textContent='Pause';draw()}
function begin(){if(sessionActive)return;const p=mode==='kana'?kanaPool():wordPool();if(!p.length){empty();return}sessionActive=true;sessionStart=performance.now();recent=[];currentStreak=0;$('#startBtn').disabled=true;$('#stopBtn').disabled=false;$('#pauseBtn').disabled=false;nextItem()}
function nextItem(){const pool=mode==='kana'?kanaPool():wordPool();if(!pool.length){empty();return}invalidateTts();let item;if(mode==='kana'){const unit=nextBalancedKana();if(!unit){empty();return}current={mode:'kana',unit,romaji:ROMAJI[unit]}}else{item=choose(pool,x=>x.id);addRecent(item.id);current={mode:'words',word:item}}shownSinceReset++;persistStat();current.pausePhase='challenge';current.challengeStart=performance.now();phase='challenge';$('#phaseLabel').textContent=mode==='kana'?'Kana':'Word';$('#visual').textContent=mode==='kana'?current.unit:(hiraToKata(current.word.hira)||current.word.jp);$('#answerRomaji').classList.add('hidden');$('#answerMeaning').classList.add('hidden');$('#status').textContent='Recognize it before the timer ends.';$('#pauseBadge').classList.add('hidden');$('#pauseBtn').textContent='Pause';startTimer(settingsFor().challenge*1000)}
function transitionPhase(){if(!sessionActive||!current)return;if(phase==='challenge'){const elapsed=settingsFor().challenge*1000;challengeSamples.push(elapsed);if(challengeSamples.length>100)challengeSamples.shift();phase='answer';current.pausePhase='answer';if(mode==='kana'){$('#answerRomaji').textContent=String(current.romaji).toUpperCase();$('#answerRomaji').classList.remove('hidden')}else{$('#answerRomaji').textContent=`${current.word.romaji}`;$('#answerRomaji').classList.remove('hidden');$('#answerMeaning').textContent=current.word.meaning||'Meaning unavailable';$('#answerMeaning').classList.remove('hidden')}$('#phaseLabel').textContent='Answer';$('#status').textContent='Moving automatically…';startTimer(settingsFor().answer*1000)}else{completedSinceReset++;currentStreak++;bestSinceReset=Math.max(bestSinceReset,currentStreak);persistStat();nextItem()}}
function stop(show=true){if(sessionActive){sessionAccum+=performance.now()-sessionStart;sessionStart=0;sessionActive=false}stopTimer();invalidateTts();phase='idle';current=null;$('#startBtn').disabled=false;$('#stopBtn').disabled=true;$('#pauseBtn').disabled=true;$('#pauseBtn').textContent='Pause';$('#pauseBadge').classList.add('hidden');if(show){$('#phaseLabel').textContent='Session ended';$('#visual').textContent='Session ended';$('#answerRomaji').classList.add('hidden');$('#answerMeaning').classList.add('hidden');$('#status').textContent='Press Start to begin again.';$('#timer').textContent='';$('#fill').style.width='100%'}else renderIdle()}
function resetSession(){stop(false);shownSinceReset=completedSinceReset=0;currentStreak=bestSinceReset=0;challengeSamples=[];sessionAccum=0;recent=[];persistStat();renderIdle()}
function empty(){$('#phaseLabel').textContent='No items';$('#visual').textContent='No items available';$('#answerRomaji').classList.add('hidden');$('#answerMeaning').classList.add('hidden');$('#status').textContent=mode==='kana'?'Select at least one Katakana unit.':'No words match these settings.';$('#timer').textContent='';$('#fill').style.width='100%';stopTimer();invalidateTts()}
function renderIdle(){phase='idle';$('#phaseLabel').textContent='Ready';$('#visual').textContent='Ready';$('#answerRomaji').classList.add('hidden');$('#answerMeaning').classList.add('hidden');$('#status').textContent='Choose a difficulty, then press Start.';$('#timer').textContent='';$('#fill').style.width='100%';$('#pauseBadge').classList.add('hidden');$('#startBtn').disabled=false;$('#stopBtn').disabled=!sessionActive;$('#pauseBtn').disabled=true;renderStats();renderPool()}
function renderPool(){$('#poolStat')?.remove();if(mode==='words')$('#wordPool').innerHTML=`<b>${wordPool().length.toLocaleString()}</b> words in current pool`;renderStats()}
function kanaPool(){return activeKana.map(x=>[x,ROMAJI[x]]).filter(x=>x[1])}

/* ---------- Manual TTS ---------- */
$('#playBtn').addEventListener('click',()=>{if(!sessionActive||!current||phase==='idle')return;const snap=current,text=mode==='kana'?snap.unit:(hiraToKata(snap.word.hira)||snap.word.jp);speakJapanese(text,()=>sessionActive&&current===snap&&(phase==='challenge'||phase==='answer'||phase==='paused'))});

/* ---------- Kana selector ---------- */
function renderKana(){
 const make=(g)=>`<div class="row"><button class="label-btn" type="button" data-row="${g}">${g.toUpperCase()}</button>${GROUPS[g].map(k=>`<label class="chip"><input type="checkbox" data-kana="${k}">${k}</label>`).join('')}</div>`;
 $('#kanaBasic').innerHTML=BASIC.map(make).join('');$('#kanaDakuten').innerHTML=DAKU.map(make).join('');$('#kanaHanda').innerHTML=make('pa');$('#kanaYoon').innerHTML=YOON.map(make).join('');syncKana();
}
function syncKana(){$$('[data-kana]').forEach(x=>x.checked=activeKana.includes(x.dataset.kana));const set=new Set(activeKana);$('#kanaSummary').innerHTML=`<b>Basic:</b> ${BASIC_KANA.filter(x=>set.has(x)).length}/${BASIC_KANA.length} · <b>Dakuten:</b> ${DAKU_KANA.filter(x=>set.has(x)).length}/${DAKU_KANA.length}<br><b>Handakuten:</b> ${HANDA_KANA.filter(x=>set.has(x)).length}/${HANDA_KANA.length} · <b>Yōon:</b> ${YOON_KANA.filter(x=>set.has(x)).length}/${YOON_KANA.length}<br><b>Total:</b> ${activeKana.length} practice units`;renderPool()}
function saveKanaFromUI(){activeKana=$$('[data-kana]:checked').map(x=>x.dataset.kana);savedKana=[...activeKana];save(KANA_KEY,savedKana);settings.kanaPreset='my';save(SETTINGS_KEY,settings);resetKanaDistribution();syncKana();if(sessionActive)stop(false);else renderIdle()}
document.addEventListener('change',e=>{if(e.target.matches('[data-kana]'))saveKanaFromUI()});
document.addEventListener('click',e=>{const b=e.target.closest('[data-row]');if(!b)return;const row=GROUPS[b.dataset.row]||[],set=new Set(activeKana),all=row.every(x=>set.has(x));row.forEach(x=>all?set.delete(x):set.add(x));activeKana=[...set];save(KANA_KEY,activeKana);settings.kanaPreset='my';save(SETTINGS_KEY,settings);resetKanaDistribution();syncKana();if(sessionActive)stop(false);else renderIdle()});
$('#kanaAll').addEventListener('click',()=>{activeKana=[...ALL_UNITS];savedKana=[...activeKana];save(KANA_KEY,savedKana);settings.kanaPreset='my';save(SETTINGS_KEY,settings);resetKanaDistribution();syncKana();if(sessionActive)stop(false);else renderIdle()});
$('#kanaNone').addEventListener('click',()=>{activeKana=[];savedKana=[];save(KANA_KEY,[]);settings.kanaPreset='my';save(SETTINGS_KEY,settings);syncKana();if(sessionActive)stop(false);else renderIdle()});

/* ---------- Difficulty/settings ---------- */
function syncPresets(){const wrap=mode==='kana'?$('#kanaPresetButtons'):$('#wordPresetButtons'),p=mode==='kana'?settings.kanaPreset:settings.wordPreset;wrap.querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.kpreset===p||b.dataset.wpreset===p))}
$$('#kanaPresetButtons button').forEach(b=>b.addEventListener('click',()=>{let p=b.dataset.kpreset;if(KPRE[p]){settings.kanaChallenge=KPRE[p][0];settings.kanaAnswer=KPRE[p][1];$('#kanaChallenge').value=settings.kanaChallenge;$('#kanaAnswer').value=settings.kanaAnswer}settings.kanaPreset=p;save(SETTINGS_KEY,settings);syncPresets();if(sessionActive)stop(false);renderIdle()}));
$$('#wordPresetButtons button').forEach(b=>b.addEventListener('click',()=>{let p=b.dataset.wpreset;if(WPRE[p]){settings.wordChallenge=WPRE[p][0];settings.wordAnswer=WPRE[p][1];settings.wordMin=WPRE[p][2];settings.wordMax=WPRE[p][3];$('#wordChallenge').value=settings.wordChallenge;$('#wordAnswer').value=settings.wordAnswer;$('#wordMin').value=settings.wordMin;$('#wordMax').value=settings.wordMax}settings.wordPreset=p;save(SETTINGS_KEY,settings);renderWordSettings();syncPresets();if(sessionActive)stop(false);renderIdle()}));
function validateNums(){settings.kanaChallenge=Math.max(.05,+$('#kanaChallenge').value||.05);settings.kanaAnswer=Math.max(.05,+$('#kanaAnswer').value||.05);settings.wordChallenge=Math.max(.05,+$('#wordChallenge').value||.05);settings.wordAnswer=Math.max(.05,+$('#wordAnswer').value||.05);settings.wordMin=Math.max(1,Math.floor(+$('#wordMin').value||1));settings.wordMax=Math.max(settings.wordMin,Math.floor(+$('#wordMax').value||settings.wordMin));save(SETTINGS_KEY,settings)}
$('#kanaChallenge').addEventListener('change',()=>{settings.kanaPreset='custom';validateNums();syncPresets();renderIdle()});$('#kanaAnswer').addEventListener('change',()=>{settings.kanaPreset='custom';validateNums();syncPresets();renderIdle()});
for(const id of ['wordChallenge','wordAnswer','wordMin','wordMax'])$('#'+id).addEventListener('change',()=>{settings.wordPreset='custom';validateNums();renderWordSettings();syncPresets();renderIdle()});

/* ---------- Word custom selector ---------- */
function renderWordSettings(){$('#wordPreset').value=settings.wordPreset||'easy';$('#wordChallenge').value=settings.wordChallenge;$('#wordAnswer').value=settings.wordAnswer;$('#wordMin').value=settings.wordMin;$('#wordMax').value=settings.wordMax;$('#customArea').classList.toggle('hidden',settings.wordPreset!=='custom');renderWordList();renderPool()}
function renderWordList(){const q=$('#wordSearch').value.trim().toLowerCase(),lvl=$('#wordLevel').value,a=fullWords.filter(w=>(lvl==='all'||w.level===lvl)&&(!q||w.jp.toLowerCase().includes(q)||w.hira.includes(q)||w.romaji.toLowerCase().includes(q)||String(w.meaning).toLowerCase().includes(q)));const shown=a.slice(0,300);$('#customSummary').innerHTML=`Custom selected: <b>${customWords.size.toLocaleString()}</b> words · Showing ${Math.min(300,a.length).toLocaleString()} of ${a.length.toLocaleString()}`;$('#customList').innerHTML=shown.map(w=>{const k=`${w.jp}|${w.hira}`;return `<label class="word-item"><input type="checkbox" data-word-key="${esc(k)}" ${customWords.has(k)?'checked':''}><span><b>${esc(w.hira)}</b><div>${esc(w.jp)} · ${esc(hiraToKata(w.hira))} · ${esc(w.romaji)} · ${esc(w.meaning||'')} ${w.level?'· '+esc(w.level):''}</div></span></label>`}).join('');$('#customList').querySelectorAll('[data-word-key]').forEach(c=>c.addEventListener('change',()=>{c.checked?customWords.add(c.dataset.wordKey):customWords.delete(c.dataset.wordKey);save(CUSTOM_KEY,[...customWords]);renderWordSettings();if(sessionActive)stop(false)}))}
$('#wordSearch').addEventListener('input',renderWordList);$('#wordLevel').addEventListener('change',renderWordList);$('#wordPreset').addEventListener('change',e=>{settings.wordPreset=e.target.value;save(SETTINGS_KEY,settings);renderWordSettings();if(sessionActive)stop(false);renderIdle()});$('#selectShown').addEventListener('click',()=>{$('#customList').querySelectorAll('[data-word-key]').forEach(c=>customWords.add(c.dataset.wordKey));save(CUSTOM_KEY,[...customWords]);renderWordSettings()});$('#clearCustom').addEventListener('click',()=>{customWords.clear();save(CUSTOM_KEY,[]);renderWordSettings();renderIdle()});

/* ---------- Mode / controls ---------- */
function switchMode(m){if(mode===m)return;stop(false);mode=m;settings.mode=m;save(SETTINGS_KEY,settings);$('#kanaMode').classList.toggle('active',m==='kana');$('#wordMode').classList.toggle('active',m==='words');$('#kanaSettings').open=m==='kana';$('#wordSettings').open=m==='words';$('#kanaTiming').classList.toggle('hidden',m!=='kana');$('#wordDifficulty').classList.toggle('hidden',m!=='words');syncPresets();renderIdle()}
$('#kanaMode').addEventListener('click',()=>switchMode('kana'));$('#wordMode').addEventListener('click',()=>switchMode('words'));
$('#startBtn').addEventListener('click',begin);$('#pauseBtn').addEventListener('click',()=>phase==='paused'?resume():pause());$('#stopBtn').addEventListener('click',()=>stop(true));$('#resetBtn').addEventListener('click',resetSession);
document.addEventListener('keydown',e=>{if(e.code!=='Space'||e.repeat)return;const t=e.target?.tagName?.toLowerCase();if(['input','select','textarea','button'].includes(t)||e.target?.isContentEditable)return;e.preventDefault();if(!sessionActive)begin();else phase==='paused'?resume():pause()});

/* ---------- Init ---------- */
$('#kanaChallenge').value=settings.kanaChallenge;$('#kanaAnswer').value=settings.kanaAnswer;$('#wordChallenge').value=settings.wordChallenge;$('#wordAnswer').value=settings.wordAnswer;$('#wordMin').value=settings.wordMin;$('#wordMax').value=settings.wordMax;
renderKana();resetKanaDistribution();$('#kanaMode').classList.toggle('active',mode==='kana');$('#wordMode').classList.toggle('active',mode==='words');$('#kanaTiming').classList.toggle('hidden',mode!=='kana');$('#wordDifficulty').classList.toggle('hidden',mode!=='words');$('#kanaSettings').open=mode==='kana';$('#wordSettings').open=mode==='words';renderWordSettings();
shownSinceReset=load(STATS_KEY,{kana:{items:0,completed:0},words:{items:0,completed:0}})[mode].items||0;completedSinceReset=load(STATS_KEY,{kana:{items:0,completed:0},words:{items:0,completed:0}})[mode].completed||0;bestSinceReset=load(STATS_KEY,{kana:{best:0},words:{best:0}})[mode].best||0;renderStats();renderIdle();syncFull();
</script>
