<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Japanese Reading Speed</title>
<style>
:root{--bg:#f4f5f8;--card:#fff;--panel:#f8f9fb;--text:#17191f;--muted:#6d7280;--border:#dfe2e8;--accent:#5865f2;--accentbg:#eef0ff;--bad:#b42318;--track:#dfe2e8}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI","Noto Sans JP",sans-serif}
.app{max-width:980px;margin:auto;padding:18px 15px 45px}header{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;flex-wrap:wrap}
h1{margin:0;font-size:23px}.sub{margin-top:4px;color:var(--muted);font-size:13px}.data{font-size:11px;color:var(--muted);text-align:right}
.mode{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:16px 0}.mode button{font-size:16px}.mode button.active,.primary{background:var(--accentbg);border-color:var(--accent)}
button,input,select{font:inherit;color:inherit}button{min-height:42px;border:1px solid var(--border);border-radius:10px;background:var(--card);padding:8px 12px;font-weight:750;cursor:pointer}button:hover{border-color:#aeb2bd}button:disabled{opacity:.55;cursor:not-allowed}
.main{background:var(--card);border:1px solid var(--border);border-radius:18px;min-height:430px;padding:26px 16px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative}
.phase{position:absolute;top:14px;left:15px;font-size:11px;font-weight:850;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}
.visual{min-height:150px;display:flex;align-items:center;justify-content:center;font-size:96px;line-height:1.1;font-weight:850;word-break:break-word;width:100%}.romaji{font-size:26px;color:var(--muted);font-weight:800;margin-top:10px}.meaning{font-size:22px;font-weight:800;margin-top:9px;max-width:800px}.status{min-height:22px;margin-top:12px;color:var(--muted);font-size:13px}.timer{font-size:15px;font-weight:850;font-variant-numeric:tabular-nums;min-height:22px;margin-top:3px}
.progress{width:min(670px,90%);height:9px;background:var(--track);border-radius:999px;overflow:hidden;margin-top:10px}.fill{width:100%;height:100%;background:var(--accent);transform-origin:left center}
.actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:18px}.actions button{min-width:118px}.pause-badge{margin-top:10px;padding:6px 11px;border:1px solid var(--bad);border-radius:999px;color:var(--bad);font-size:12px;font-weight:850}
.stats{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin-top:11px}.stat{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:9px 4px;text-align:center}.stat b{display:block;font-size:18px;font-variant-numeric:tabular-nums}.stat span{font-size:10px;color:var(--muted);text-transform:uppercase}
details{background:var(--card);border:1px solid var(--border);border-radius:13px;margin-top:9px}summary{cursor:pointer;padding:13px 15px;font-weight:850;list-style:none}summary::-webkit-details-marker{display:none}.inside{padding:0 15px 15px}
.presets{display:flex;gap:7px;flex-wrap:wrap}.presets button.active{background:var(--accentbg);border-color:var(--accent)}
.setting-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.field{display:flex;flex-direction:column;gap:5px;color:var(--muted);font-size:12px;font-weight:800}.field input,.field select,.search{min-height:40px;border:1px solid var(--border);border-radius:9px;background:var(--panel);padding:8px}
.kana-groups{display:grid;gap:7px}.row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.label-btn{min-width:48px;min-height:36px;padding:6px 8px}.chip{display:inline-flex;gap:4px;align-items:center;border:1px solid var(--border);border-radius:8px;background:var(--card);min-height:36px;padding:6px 8px;cursor:pointer;user-select:none}.chip input{width:auto;margin:0}.chip:has(input:checked){background:var(--accentbg);border-color:var(--accent)}
.summary,.note{background:var(--panel);border:1px solid var(--border);border-radius:9px;padding:9px;color:var(--muted);font-size:12px;line-height:1.5;margin-top:10px}
.word-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.word-controls select{min-height:40px;border:1px solid var(--border);border-radius:9px;background:var(--panel);padding:8px}
.custom{margin-top:10px}.custom-tools{display:grid;grid-template-columns:2fr 1fr;gap:8px}.list{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;max-height:310px;overflow:auto;margin-top:9px}.word-item{display:flex;gap:7px;align-items:flex-start;border:1px solid var(--border);border-radius:8px;background:var(--panel);padding:7px;font-size:12px}.word-item input{margin-top:3px}.word-item b{font-size:15px}.word-item div{margin-top:2px;color:var(--muted);line-height:1.3}.hidden{display:none!important}
@media(max-width:760px){.stats{grid-template-columns:repeat(3,1fr)}.visual{font-size:74px}.custom-tools{grid-template-columns:1fr}.list{grid-template-columns:1fr 1fr}.setting-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.app{padding:11px 9px 35px}.visual{font-size:62px}.main{min-height:375px}.setting-grid,.list{grid-template-columns:1fr}}
@media(prefers-color-scheme:dark){:root{--bg:#101218;--card:#191c23;--panel:#20242d;--text:#f3f4f7;--muted:#a8adb9;--border:#343946;--accentbg:#292f59;--track:#343946}}
</style>
</head>
<body>
<main class="app">
<header><div><h1>Japanese Reading Speed</h1><div class="sub">See → recognize → move on</div></div><div id="dataStatus" class="data">806-word local bank ready</div></header>

<div class="mode"><button id="kanaMode" class="active">Kana Mode</button><button id="wordMode">Word Mode</button></div>

<section class="main">
 <div id="phaseLabel" class="phase">Ready</div>
 <div id="visual" class="visual">Ready</div>
 <div id="answerRomaji" class="romaji hidden"></div>
 <div id="answerMeaning" class="meaning hidden"></div>
 <div id="status" class="status">Choose a difficulty, then press Start.</div>
 <div id="timer" class="timer"></div>
 <div class="progress"><div id="fill" class="fill"></div></div>
 <div class="actions">
  <button id="startBtn" class="primary">Start</button><button id="pauseBtn" disabled>Pause</button><button id="stopBtn" disabled>Stop / End</button><button id="resetBtn">Reset Session</button><button id="playBtn">🔊 Play</button>
 </div>
 <div id="pauseBadge" class="pause-badge hidden">PAUSED</div>
</section>

<div class="stats">
 <div class="stat"><b id="items">0</b><span>Items shown</span></div><div class="stat"><b id="done">0</b><span>Completed</span></div>
 <div class="stat"><b id="streak">0</b><span>Streak</span></div><div class="stat"><b id="best">0</b><span>Best</span></div>
 <div class="stat"><b id="avg">0.0s</b><span>Avg challenge</span></div><div class="stat"><b id="sessionTime">0:00</b><span>Session time</span></div>
</div>

<details id="difficultyBox" open><summary>Difficulty / Timing</summary><div class="inside">
 <div id="kanaPresetButtons" class="presets"><button data-kpreset="easy">Easy</button><button data-kpreset="normal">Normal</button><button data-kpreset="hard">Hard</button><button data-kpreset="expert">Expert</button><button data-kpreset="custom">Custom</button></div>
 <div id="kanaTiming" class="setting-grid"><label class="field">Challenge seconds<input id="kanaChallenge" type="number" min=".05" step=".1"></label><label class="field">Answer seconds<input id="kanaAnswer" type="number" min=".05" step=".1"></label></div>
 <div id="wordDifficulty" class="hidden">
  <div id="wordPresetButtons" class="presets"><button data-wpreset="easy">Easy</button><button data-wpreset="normal">Normal</button><button data-wpreset="hard">Hard</button><button data-wpreset="expert">Expert</button><button data-wpreset="custom">Custom</button></div>
  <div class="setting-grid"><label class="field">Challenge seconds<input id="wordChallenge" type="number" min=".05" step=".1"></label><label class="field">Answer seconds<input id="wordAnswer" type="number" min=".05" step=".1"></label></div>
  <div class="setting-grid"><label class="field">Minimum word units<input id="wordMin" type="number" min="1" step="1"></label><label class="field">Maximum word units<input id="wordMax" type="number" min="1" step="1"></label></div>
 </div>
 <div class="note">Kana: Easy 5s/3s · Normal 2.5s/2s · Hard 1s/1.5s · Expert 0.5s/1s. Word presets also filter by length and, when source metadata is available, favor/commonness by frequency.</div>
</div></details>

<details id="kanaSettings" open><summary>Practice Set / Select Katakana</summary><div class="inside">
 <div class="kana-groups"><div class="small">Basic</div><div id="kanaBasic"></div><div class="small">Dakuten</div><div id="kanaDakuten"></div><div class="small">Handakuten</div><div id="kanaHanda"></div><div class="small">Yōon / Digraphs</div><div id="kanaYoon"></div></div>
 <div class="actions"><button id="kanaAll">Select All</button><button id="kanaNone">Deselect All</button></div>
 <div id="kanaSummary" class="summary"></div>
</div></details>

<details id="wordSettings"><summary>Word Practice Settings</summary><div class="inside">
 <div class="word-controls"><select id="wordPreset"><option value="easy">Easy</option><option value="normal">Normal</option><option value="hard">Hard</option><option value="expert">Expert</option><option value="all">All Words</option><option value="custom">Custom</option></select><div id="wordPool" class="small" style="margin:0"></div></div>
 <div id="customArea" class="custom hidden"><div class="custom-tools"><input id="wordSearch" class="search" placeholder="Search Japanese, hiragana, romaji, English"><select id="wordLevel"><option value="all">All levels</option><option value="N5">N5</option><option value="N4">N4</option><option value="N3">N3</option><option value="N2">N2</option><option value="N1">N1</option><option value="Advanced">Advanced / unclassified</option></select></div>
  <div class="actions"><button id="selectShown">Select shown</button><button id="clearCustom">Clear custom</button></div><div id="customSummary" class="summary"></div><div id="customList" class="list"></div>
 </div>
 <div class="note">Word length is counted in reading units, so a yōon such as きょ counts as one unit. Words are never generated artificially.</div>
</div></details>
</main>

